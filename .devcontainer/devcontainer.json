{
  "name": "Android Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "redhat.vscode-xml",
        "esafirm.android-ide"
      ]
    }
  },
  "postCreateCommand": "chmod +x gradlew && ./gradlew --no-daemon assembleDebug",
  "remoteUser": "vscode"
}
